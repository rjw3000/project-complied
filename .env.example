# Copy to .env only on the private host; never commit the filled file.
COMPLIED_DOMAIN=internal.example.com
COMPLIED_PUBLIC_ORIGIN=https://internal.example.com
COMPLIED_AUTH_MODE=microsoft
COMPLIED_DB=/data/complied.sqlite3
COMPLIED_TENANT_ID=00000000-0000-0000-0000-000000000000
COMPLIED_CLIENT_ID=00000000-0000-0000-0000-000000000000
COMPLIED_CLIENT_SECRET=replace-on-private-host
COMPLIED_OWNER_OID=00000000-0000-0000-0000-000000000000
COMPLIED_DELEGATE_OIDS=
# Generate on the host with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
COMPLIED_TOKEN_KEY=generate-on-private-host
COMPLIED_LIVE_SEND=0
